# LLM Provider
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# 嵌入模型（知识库向量检索用，走 OpenAI 兼容的 /embeddings 接口）
# 阿里云百炼用 text-embedding-v4（1024 维，当前索引即按此构建）；
# 换用 OpenAI 官方则填 text-embedding-3-small，索引会因维度变化自动重建
EMBEDDING_MODEL=text-embedding-v4

# Redis (Agent State 检查点存储，需 Redis Stack / Redis 8+)
# 端口与 docker/local/docker-compose.yml 的 redis host 映射保持一致
REDIS_URL=redis://:123456@localhost:6380/0

# 知识库向量检索（Qdrant，dense 语义 + BM25 关键词混合召回，RRF 融合后精排）
# 旧 FAISS 路径保留到在线链路切换完成（阶段 4），之后删除
FAISS_INDEX_PATH=./vector_store/faiss_index
KNOWLEDGE_BASE_DIR=./knowledge_base
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                      # 云端实例才需要，本地留空
EMBEDDING_DIM=1024                     # 与 EMBEDDING_MODEL 输出维度一致
RAG_MIN_SCORE=0.5                      # 向量召回最低分（粗排过滤）
RECALL_TOP_N=10                        # 每路召回条数
RRF_K=60                               # RRF 融合常数
HNSW_EF=64                             # Qdrant 检索精度

# 精排（百炼 text-rerank，OpenAI 兼容 /rerank 接口）
RERANK_MODEL=text-rerank-v2
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_API_KEY=sk-your-rerank-api-key
RERANK_ENABLED=true
RERANK_TOP_N=5

# 回答判定阈值
FAQ_CONFIDENCE_THRESHOLD=0.7           # FAQ 混合召回融合分：过阈值直接回标准答案
FAQ_RECALL_TOP_N=5
ANSWER_THRESHOLD=0.6                   # RAG 精排分：过阈值才生成回答，否则拒答引导工单

# OCR（可选，仅处理扫描件 PDF / 图片时需要；模型缓存目录避免重建镜像重复下载）
# PADDLE_HOME=/app/models/paddle
# OCR_LANG=ch
# PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=false  # 部分 CPU 上 oneDNN 推理会崩，此时关掉

# 资源护栏
# 单次回复最多输出的 token 数（tiktoken cl100k_base 估算，非计费口径），超限截断并补说明
MAX_REPLY_TOKENS=1024
# 单个会话最多处理的轮次，超出后不再调用模型，只回固定话术
MAX_TURNS=30

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=mall-customer
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000

# 服务间共享密钥（mall-server 调用本服务时需带 Authorization: Bearer <token>，
# 本服务通过 MCP 调用 mall-server 工具时需带 X-Internal-Token: <token>）
# 留空则本服务拒绝所有对话与历史请求；本地默认值与 mall-server 的 dev 配置一致
INTERNAL_API_TOKEN=dev-internal-token

# mall-server 地址（MCP 端点为 <该地址>/mcp，建单等业务工具在此调用）
MALL_SERVER_URL=http://localhost:8800

# 允许的跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
