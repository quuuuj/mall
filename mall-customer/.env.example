# LLM Provider
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# 嵌入模型（知识库向量检索用，走 OpenAI 兼容的 /embeddings 接口）
# 阿里云百炼用 text-embedding-v4（1024 维，当前索引即按此构建）；
# 换用 OpenAI 官方则填 text-embedding-3-small，索引会因维度变化自动重建
EMBEDDING_MODEL=text-embedding-v4

# Redis (Agent State 检查点存储，需 Redis Stack / Redis 8+)
# 端口与 docker/local/docker-compose.yml 的 redis host 映射保持一致
REDIS_URL=redis://:123456@localhost:6380/0

# Vector Store (长期记忆)
FAISS_INDEX_PATH=./vector_store/faiss_index
# 知识库文档目录（markdown，一篇文件一篇文档）
KNOWLEDGE_BASE_DIR=./knowledge_base
# 检索最低相似度，低于该值视为空召回（空召回走四类工单引导）
# 0.5 是按当前知识库标定的：业务问题通常 >=0.54，闲聊/越界问题通常 <0.5
RAG_MIN_SCORE=0.5
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=mall-customer
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000

# 服务间共享密钥（mall-server 调用本服务时需带 Authorization: Bearer <token>，
# 本服务通过 MCP 调用 mall-server 工具时需带 X-Internal-Token: <token>）
# 留空则本服务拒绝所有对话与历史请求；本地默认值与 mall-server 的 dev 配置一致
INTERNAL_API_TOKEN=dev-internal-token

# mall-server 地址（MCP 端点为 <该地址>/mcp，建单等业务工具在此调用）
MALL_SERVER_URL=http://localhost:8800

# 允许的跨域来源，逗号分隔
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
