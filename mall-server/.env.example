# mall-server 本地开发配置模板
# 使用：复制为 .env 后填入真实值（.env 不入库，已 gitignore；本文件为模板，可入库）
#   cp .env.example .env
# 由 application-dev.yml 的 spring.config.import 加载，无需 export；
# 格式为 properties：KEY=value，勿写 export 前缀，值两边不加引号。

# 阿里云 OSS（图片服务；AccessKey 留空则走 NoOp 降级：服务可启动，但上传/删除抛异常）
OSS_ENDPOINT=<OSS服务Endpoint>
OSS_ACCESS_KEY_ID=<云服务AccessKeyId>
OSS_ACCESS_KEY_SECRET=<云服务AccessKeySecret>
OSS_BUCKET_NAME=<OSS存储桶名称>
